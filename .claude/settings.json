{
  "disableAllHooks": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "process.exitCode=2;try{if(require(process.argv[1])!==true)throw 0}catch(e){process.exitCode=2;try{require(process.argv[1]+'/../lib/rules.cjs').unloaded(e)}catch{require('fs').writeSync(2,'fail closed '+(e&&e.code))}}",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs",
              "shell"
            ],
            "onFailure": "block",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "process.exitCode=2;try{if(require(process.argv[1])!==true)throw 0}catch(e){process.exitCode=2;try{require(process.argv[1]+'/../lib/rules.cjs').unloaded(e)}catch{require('fs').writeSync(2,'fail closed '+(e&&e.code))}}",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs",
              "write"
            ],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "process.exitCode=2;try{if(require(process.argv[1])!==true)throw 0}catch(e){process.exitCode=2;try{require(process.argv[1]+'/../lib/rules.cjs').unloaded(e)}catch{require('fs').writeSync(2,'fail closed '+(e&&e.code))}}",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs",
              "read"
            ],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "process.exitCode=2;try{if(require(process.argv[1])!==true)throw 0}catch(e){process.exitCode=2;try{require(process.argv[1]+'/../lib/rules.cjs').unloaded(e)}catch{require('fs').writeSync(2,'fail closed '+(e&&e.code))}}",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs",
              "format"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "process.exitCode=2;try{if(require(process.argv[1])!==true)throw 0}catch(e){process.exitCode=2;try{require(process.argv[1]+'/../lib/rules.cjs').unloaded(e)}catch{require('fs').writeSync(2,'fail closed '+(e&&e.code))}}",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs",
              "stop"
            ],
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
