{
  "id": "T-epic-adapter-01b7a9a786",
  "file": "test/epic-adapter.test.ts",
  "suite": [
    "EpicAdapter: a session that no One Launch account owns (B23)"
  ],
  "name": "pins the snapshot a restore takes first when the state it replaces is such a session",
  "calls": [
    {
      "launcher": "epic",
      "method": "switchAccount",
      "args": [
        {
          "id": "@acct:epic:alt@example.com",
          "displayName": "Alt",
          "login": "alt@example.com",
          "launcherUid": "22222222222222222222222222222222",
          "hasSecret": false
        },
        {
          "dryRun": false
        }
      ],
      "outcome": "returned",
      "result": {
        "launcher": "epic",
        "account": {
          "id": "@acct:epic:alt@example.com",
          "displayName": "Alt",
          "login": "alt@example.com",
          "launcherUid": "22222222222222222222222222222222"
        },
        "strategy": "remembered",
        "ok": true,
        "steps": [
          {
            "id": "close",
            "title": "Close Epic Games Launcher",
            "status": "skipped",
            "detail": "Skipped: EpicGamesLauncher.exe is not running."
          },
          {
            "id": "capture",
            "title": "Save the outgoing session",
            "status": "done",
            "detail": "Main's stored session is already current."
          },
          {
            "id": "backup",
            "title": "Back up GameUserSettings.ini",
            "status": "done",
            "detail": "{tmp}\\backups\\epic\\<ts>"
          },
          {
            "id": "file",
            "title": "Put the account's session in place",
            "status": "done",
            "detail": "[RememberMe] now holds the snapshot (fingerprint 79a15d60) in 1 file."
          },
          {
            "id": "start",
            "title": "Start Epic Games Launcher",
            "status": "done",
            "detail": "Launcher started."
          },
          {
            "id": "wait",
            "title": "Wait for the launcher to come up",
            "status": "done",
            "detail": "EpicGamesLauncher.exe is running."
          },
          {
            "id": "verify",
            "title": "Confirm the launcher signed in",
            "status": "done",
            "detail": "Signed in as alt@example.com."
          },
          {
            "id": "manual",
            "title": "Wait for you to sign in",
            "status": "skipped",
            "detail": "Runs only if the launcher rejects the stored session (expired token) or does not sign in within 0.04 s. The launcher stays open on its sign-in page; you sign in there once as alt@example.com and One Launch continues with the game as soon as the log reports the sign-in, up to 0.0013333333333333333 min."
          },
          {
            "id": "recapture",
            "title": "Save the new session",
            "status": "skipped",
            "detail": "Runs only after a manual sign-in: the fresh [RememberMe] replaces the stale snapshot."
          }
        ],
        "startedAt": "<ts>",
        "finishedAt": "<ts>",
        "readyAt": "<ts>",
        "startedWithGame": null,
        "backupId": "<ts>",
        "restored": null,
        "error": null,
        "needsSignIn": false,
        "cancelled": false
      }
    },
    {
      "launcher": "epic",
      "method": "restoreBackup",
      "args": [
        "<ts>"
      ],
      "outcome": "returned",
      "result": {
        "launcher": "epic",
        "id": "<ts>",
        "files": [
          "{tmp}\\Local\\EpicGamesLauncher\\Saved\\Config\\Windows\\GameUserSettings.ini"
        ],
        "registry": []
      }
    },
    {
      "launcher": "epic",
      "method": "restoreBackup",
      "args": [
        "<ts>"
      ],
      "outcome": "returned",
      "result": {
        "launcher": "epic",
        "id": "<ts>",
        "files": [
          "{tmp}\\Local\\EpicGamesLauncher\\Saved\\Config\\Windows\\GameUserSettings.ini"
        ],
        "registry": []
      }
    }
  ]
}
