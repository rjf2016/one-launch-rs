{
  "function": "splitSavedAccountNames",
  "source": "src/main/launchers/battlenet/config.ts",
  "note": "decode: none\narg0 is Client.SavedAccountNames as read from the parsed document (a string), or null when absent; in memory.",
  "cases": [
