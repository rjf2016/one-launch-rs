    {
      "id": "test-literal",
      "origin": {
        "kind": "test",
        "ref": "test/update-manifest.test.ts > release manifest signatures > signs a fixed, newline-separated payload"
      },
      "args": [
        "1.2.3",
        {
          "url": "a.exe",
          "sha512": "h",
          "size": 7
        }
      ],
      "out": "one-launch-update-v1\n1.2.3\na.exe\nh\n7\n"
    },
    {
      "id": "fixture-latest",
